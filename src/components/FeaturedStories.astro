---
interface Story {
  title: string;
  category: string;
  categoryHref: string;
  excerpt: string;
  image: string;
  href: string;
}

const stories: Story[] = [
  {
    title: "10 Elevated Basics Every Wardrobe Needs This Season",
    category: "Fashion",
    categoryHref: "/fashion",
    excerpt: "The foundation of any elevated look starts with impeccable basics. Here are the pieces worth investing in.",
    image: "",
    href: "/fashion/10-elevated-basics",
  },
  {
    title: "A Complete Guide to Korean Sunscreen: Why It's Changing the Game",
    category: "Beauty",
    categoryHref: "/beauty",
    excerpt: "K-beauty sunscreens have redefined what daily sun protection feels like. Here's why they're worth the hype.",
    image: "",
    href: "/beauty/korean-sunscreen-guide",
  },
  {
    title: "The Rise of Smart Home Devices Worth Actually Buying",
    category: "Technology",
    categoryHref: "/technology",
    excerpt: "Not all smart home gadgets earn their place. We tested dozens to find the ones that truly improve daily life.",
    image: "",
    href: "/technology/smart-home-devices-worth-it",
  },
  {
    title: "Bali Beyond Canggu: Quiet Corners for the Discerning Traveler",
    category: "Travel",
    categoryHref: "/travel",
    excerpt: "Skip the beach clubs. These under-the-radar spots offer a deeper, more refined Balinese experience.",
    image: "",
    href: "/travel/bali-beyond-canggu",
  },
  {
    title: "How to Style a Small Balcony Into a Green Sanctuary",
    category: "Home & Garden",
    categoryHref: "/home-garden",
    excerpt: "Even the tiniest outdoor space can become a lush retreat. Here's the step-by-step transformation guide.",
    image: "",
    href: "/home-garden/small-balcony-green-sanctuary",
  },
  {
    title: "LED Face Masks Review: Do At-Home Light Therapy Devices Work?",
    category: "Beauty",
    categoryHref: "/beauty",
    excerpt: "We tested 6 popular LED masks over 8 weeks. The results were surprising — here's what actually worked.",
    image: "",
    href: "/beauty/led-face-mask-review",
  },
];
---

<section class="featured-stories">
  <p class="section-label">Featured Stories</p>
  <div class="stories-grid">
    {stories.map(story => (
      <div class="story-card">
        <a href={story.href} class="story-image-link">
          <div class="story-image">📷</div>
        </a>
        <div class="story-body">
          <a href={story.categoryHref} class="story-category">{story.category}</a>
          <h3 class="story-title"><a href={story.href}>{story.title}</a></h3>
          <p class="story-excerpt">{story.excerpt}</p>
        </div>
      </div>
    ))}
  </div>
</section>
