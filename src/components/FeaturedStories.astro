---
interface Story {
  title: string;
  category: string;
  categoryHref: string;
  excerpt: string;
  image: string;
  href: string;
}

const stories: Story[] = [
  {
    title: "10 basiques élégants dont chaque garde-robe a besoin cette saison",
    category: "Mode",
    categoryHref: "/fashion",
    excerpt: "La base de tout look élégant commence par des basiques impeccables. Voici les pièces qui valent l'investissement.",
    image: "",
    href: "/fashion/fashion-01-elevated-basics",
  },
  {
    title: "Guide complet des écrans solaires coréens : pourquoi ils changent la donne",
    category: "Beauté",
    categoryHref: "/beauty",
    excerpt: "Les écrans solaires K-beauty ont redéfini la protection solaire quotidienne. Voici la science derrière ces produits.",
    image: "",
    href: "/beauty/beauty-01-korean-sunscreen",
  },
  {
    title: "Appareils connectés qui valent vraiment l'achat en 2026",
    category: "Technologie",
    categoryHref: "/technology",
    excerpt: "Tous les gadgets connectés ne méritent pas leur place. Nous en avons testé des dizaines pour trouver ceux qui améliorent vraiment le quotidien.",
    image: "",
    href: "/technology/tech-01-smart-home-devices",
  },
  {
    title: "Bali au-delà de Canggu : coins tranquilles pour le voyageur exigeant",
    category: "Voyage",
    categoryHref: "/travel",
    excerpt: "Oubliez les beach clubs. Ces endroits méconnus offrent une expérience balinaise plus profonde et plus raffinée.",
    image: "",
    href: "/travel/travel-01-bali-beyond-canggu",
  },
  {
    title: "Comment transformer un petit balcon en sanctuaire vert",
    category: "Maison & Jardin",
    categoryHref: "/home-garden",
    excerpt: "Même le plus petit espace extérieur peut devenir une retraite luxuriante. Voici le guide de transformation étape par étape.",
    image: "",
    href: "/home-garden/home-01-small-balcony",
  },
  {
    title: "Test des masques LED : les appareils de luminothérapie à domicile fonctionnent-ils ?",
    category: "Beauté",
    categoryHref: "/beauty",
    excerpt: "Nous avons testé 6 masques LED populaires pendant 8 semaines. Les résultats étaient surprenants — voici ce qui a vraiment fonctionné.",
    image: "",
    href: "/beauty/beauty-04-led-face-masks",
  },
];
---

<section class="featured-stories">
  <p class="section-label">Articles à la une</p>
  <div class="stories-grid">
    {stories.map(story => (
      <div class="story-card">
        <a href={story.href} class="story-image-link">
          <div class="story-image">
            <img
              src={story.image || `https://picsum.photos/seed/${story.href.replace(/\//g, "-")}/640/427`}
              alt={story.title}
              loading="lazy"
              width="640"
              height="427"
            />
          </div>
        </a>
        <div class="story-body">
          <a href={story.categoryHref} class="story-category">{story.category}</a>
          <h3 class="story-title"><a href={story.href}>{story.title}</a></h3>
          <p class="story-excerpt">{story.excerpt}</p>
        </div>
      </div>
    ))}
  </div>
</section>
