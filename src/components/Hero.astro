---
import { getCollection } from "astro:content";
import imageMap from "../content/image-map.json";

const articles = await getCollection("articles");
articles.sort((a, b) => b.data.date.localeCompare(a.data.date));
const featured = articles.slice(0, 10);

const catNames: Record<string, string> = {
  "fashion": "Mode",
  "beauty": "Beauté",
  "travel": "Voyage",
  "home-garden": "Maison & Jardin",
  "technology": "Technologie",
};
---

<section class="hero">
  <div class="hero-inner">
    <div class="hero-header">
      <span class="hero-label">Sélection de l'éditeur</span>
      <span class="hero-scroll-hint">Défiler →</span>
    </div>
  </div>
  <div class="hero-track-wrapper">
    <div class="hero-track">
      {featured.map(article => (
        <a href={`/${article.data.category}/${article.slug}`} class="hero-card">
          <div class="hero-card-image">
            <img
              src={(imageMap as any)[article.slug]?.[2] || (imageMap as any)[article.slug]?.[0] || `https://picsum.photos/seed/${article.slug}/640/853`}
              alt={article.data.title}
              loading="lazy"
              width="640"
              height="853"
            />
            <div class="hero-card-overlay">
              <span class="hero-card-category">
                {catNames[article.data.category] || article.data.category}
              </span>
              <h2 class="hero-card-title">{article.data.title}</h2>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
