---
import { getCollection } from "astro:content";

const articles = await getCollection("articles");
articles.sort((a, b) => b.data.date.localeCompare(a.data.date));
const featured = articles.slice(0, 10);

const catNames: Record<string, string> = {
  "fashion": "Fashion",
  "beauty": "Beauty",
  "travel": "Travel",
  "home-garden": "Home & Garden",
  "technology": "Technology",
};
---

<section class="hero" style="background:#fff4e6;padding:2rem 0;">
  <div class="hero-header" style="background:#ffe0b2;padding:1rem;text-align:center;font-size:1.5rem;font-weight:bold;">
    ⚡ EDITOR'S PICKS ⚡
    <span class="hero-scroll-hint" style="font-size:0.8rem;color:#999;margin-left:1rem;">Scroll →</span>
  </div>
  <div class="hero-track">
    {featured.map(article => (
      <div class="hero-card">
        <a href={`/${article.data.category}/${article.slug}`} class="hero-card-image">
          <img
            src={`https://picsum.photos/seed/${article.slug}/640/480`}
            alt={article.data.title}
            loading="lazy"
            width="640"
            height="480"
          />
        </a>
        <div class="hero-card-body">
          <a href={`/${article.data.category}`} class="hero-card-category">
            {catNames[article.data.category] || article.data.category}
          </a>
          <h2 class="hero-card-title">
            <a href={`/${article.data.category}/${article.slug}`}>{article.data.title}</a>
          </h2>
        </div>
      </div>
    ))}
  </div>
</section>
