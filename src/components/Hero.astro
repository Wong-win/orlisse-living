---
import { getCollection } from "astro:content";

const articles = await getCollection("articles");
articles.sort((a, b) => b.data.date.localeCompare(a.data.date));
const featured = articles[0];
---

<section class="hero">
  <div class="hero-inner">
    <p class="hero-tag">Editor's Pick</p>
    <h1 class="hero-title">{featured.data.title}</h1>
    <p class="hero-subtitle">{featured.data.excerpt}</p>
    <a href={`/${featured.data.category}/${featured.slug}`} class="hero-cta">Read the Story</a>
  </div>
</section>
