---
import { getCollection } from "astro:content";
import imageMap from "../content/image-map.json";

const categories = [
  { slug: "fashion", name: "Mode", desc: "Style, tendances et inspiration vestimentaire" },
  { slug: "beauty", name: "Beauté", desc: "Soins de la peau, maquillage et routines" },
  { slug: "travel", name: "Voyage", desc: "Destinations, guides et équipement" },
  { slug: "home-garden", name: "Maison & Jardin", desc: "Intérieurs, plantes et art de vivre" },
  { slug: "technology", name: "Technologie", desc: "Vie connectée, gadgets et productivité" },
];

const allArticles = await getCollection("articles");
---

<section class="category-rows">
  <p class="section-label">Explorer par catégorie</p>

  {categories.map(cat => {
    const catArticles = allArticles
      .filter(a => a.data.category === cat.slug)
      .sort((a, b) => b.data.date.localeCompare(a.data.date))
      .slice(0, 5);

    return (
      <div class="cat-row">
        <div class="cat-row-header">
          <div>
            <h2 class="cat-row-name">{cat.name}</h2>
            <p class="cat-row-desc">{cat.desc}</p>
          </div>
          <a href={`/${cat.slug}`} class="cat-row-more">Tout voir →</a>
        </div>
        <div class="cat-row-track">
          {catArticles.map(article => (
            <a href={`/${cat.slug}/${article.slug}`} class="cat-card">
              <div class="cat-card-image">
                <img
                  src={(imageMap as any)[article.slug]?.[1] || (imageMap as any)[article.slug]?.[0] || `https://picsum.photos/seed/${article.slug}/400/280`}
                  alt={article.data.title}
                  loading="lazy"
                  width="400"
                  height="280"
                />
              </div>
              <div class="cat-card-body">
                <h3 class="cat-card-title">{article.data.title}</h3>
              </div>
            </a>
          ))}
        </div>
      </div>
    );
  })}
</section>
