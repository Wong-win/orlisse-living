---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import imageMap from "../../content/image-map.json";

export async function getStaticPaths() {
  const categories = ["fashion", "beauty", "travel", "home-garden", "technology"];
  return categories.map(cat => ({ params: { category: cat } }));
}

const categorySlug = Astro.params.category;

const categoryNames: Record<string, string> = {
  "fashion": "Mode",
  "beauty": "Beauté",
  "travel": "Voyage",
  "home-garden": "Maison & Jardin",
  "technology": "Technologie",
};

const categoryDescriptions: Record<string, string> = {
  "fashion": "Style, tendances, garde-robe et inspiration pour chaque occasion.",
  "beauty": "Soins, maquillage, ingrédients, outils et routines quotidiennes.",
  "travel": "Destinations, guides, hôtels, compagnies aériennes et équipement de voyage pour l'explorateur moderne.",
  "home-garden": "Inspiration intérieure, rénovations, solutions petits espaces, jardinage et outils d'entretien.",
  "technology": "Électronique grand public, maison connectée, technologie beauté, gadgets de voyage et outils de productivité.",
};

const name = categoryNames[categorySlug] || categorySlug;
const description = categoryDescriptions[categorySlug] || "";

const articles = await getCollection("articles", ({ data }) =>
  data.category === categorySlug
);

articles.sort((a, b) => b.data.date.localeCompare(a.data.date));
---

<Layout>
  <div class="category-page">
    <div class="category-header">
      <h1>{name}</h1>
      <p>{description}</p>
    </div>

    {articles.length === 0 ? (
      <p style="text-align:center;color:var(--color-text-muted);padding:4rem 0;">
        Articles coming soon. This category is being curated.
      </p>
    ) : (
      <div class="stories-grid">
        {articles.map(article => (
          <div class="story-card">
            <a href={`/${categorySlug}/${article.slug}`} class="story-image-link">
              <div class="story-image">
                <img
                  src={(imageMap as any)[article.slug]?.[1] || (imageMap as any)[article.slug]?.[0] || `https://picsum.photos/seed/${article.slug}/640/427`}
                  alt={article.data.title}
                  loading="lazy"
                  width="640"
                  height="427"
                />
              </div>
            </a>
            <div class="story-body">
              <a href={`/${categorySlug}`} class="story-category">{name}</a>
              <h3 class="story-title">
                <a href={`/${categorySlug}/${article.slug}`}>{article.data.title}</a>
              </h3>
              <p class="story-excerpt">{article.data.excerpt || ""}</p>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>
</Layout>
